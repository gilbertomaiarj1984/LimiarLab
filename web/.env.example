# Copie para .env.production na VPS (chmod 600). Nunca versionar o arquivo real.

# Em produção (VPS) o DATABASE_URL é montado pelo docker-compose a partir de POSTGRES_PASSWORD (arquivo .env).
# Só para rodar fora do compose:
# DATABASE_URL=postgresql://limiarlab:SENHA@localhost:5432/limiarlab

# Senha única de acesso ao app (fase 1, sem login de usuários)
APP_PASSWORD=
# Assina o cookie de sessão. Gere com: openssl rand -base64 32
SESSION_SECRET=
# Token da rotina do Claude para POST /api/import (mínimo 32 caracteres). Gere com: openssl rand -hex 32
IMPORT_TOKEN=
# Token só de leitura do app do relógio (GET /api/relogio). O mesmo valor vai no secret RELOGIO_TOKEN do GitHub.
RELOGIO_TOKEN=

# Atleta exibido enquanto não há login
DEFAULT_ATHLETE=giba

# Atualização pelo Strava (botão Atualizar e rotina das 9h). Crie o app em https://www.strava.com/settings/api
# "Authorization Callback Domain" = domínio do APP_URL, sem https://
APP_URL=https://limiar.143-95-214-240.sslip.io
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
