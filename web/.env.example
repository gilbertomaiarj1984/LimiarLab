# Copie para .env.production na VPS (chmod 600). Nunca versionar o arquivo real.

# Banco PRÓPRIO do LimiarLab na instância Postgres compartilhada (host = alias na rede limiarlab_db)
DATABASE_URL=postgresql://limiarlab:SENHA@limiarlab-postgres:5432/limiarlab

# Senha única de acesso ao app (fase 1, sem login de usuários)
APP_PASSWORD=
# Assina o cookie de sessão. Gere com: openssl rand -base64 32
SESSION_SECRET=
# Token da rotina do Claude para POST /api/import (mínimo 32 caracteres). Gere com: openssl rand -hex 32
IMPORT_TOKEN=

# Atleta exibido enquanto não há login
DEFAULT_ATHLETE=giba
